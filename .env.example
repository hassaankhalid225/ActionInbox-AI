# ─────────────────────────────────────────────────────────────
# ActionInbox AI — Environment Variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="ActionInbox AI"

# ── Database ──────────────────────────────────────────────────
# Dev default: local SQLite (zero-config). For production use Postgres:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/actioninbox?schema=public"
# and switch prisma/schema.prisma datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# ── Auth / Sessions ───────────────────────────────────────────
# Generate a strong secret:  openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-please-use-openssl-rand-base64-48"
SESSION_MAX_AGE_DAYS=30

# ── AI Gateway (provider abstraction) ─────────────────────────
# Options: mock | anthropic | openai
# `mock` runs a deterministic local pipeline — no API key required.
AI_PROVIDER=mock
AI_DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Object Storage (files/attachments) ────────────────────────
# Options: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Job Queue ─────────────────────────────────────────────────
# Options: inline (in-process) | redis (BullMQ — production)
QUEUE_DRIVER=inline
REDIS_URL=

# ── Channels (WhatsApp Cloud API) ─────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Email ingestion / SMTP ────────────────────────────────────
EMAIL_INBOUND_DOMAIN=inbox.actioninbox.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Billing (Stripe) ──────────────────────────────────────────
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
